{
  "name": "@carloscortezcloud/tinkuy-agent",
  "version": "0.5.0",
  "description": "Minimal provider-agnostic AI agent framework. Tool loops, budget control, multi-model routing — in 200 lines.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/core/agent.d.ts",
      "import": "./dist/core/agent.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "import": "./dist/conversation/index.js"
    },
    "./ontology": {
      "types": "./dist/ontology/index.d.ts",
      "import": "./dist/ontology/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai",
    "agent",
    "framework",
    "llm",
    "tool-use",
    "multi-model",
    "minimal",
    "agentic",
    "function-calling"
  ],
  "author": "Carlos Cortez <carlos@finoptix.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/breakingthecloud/tinkuy"
  },
  "peerDependencies": {
    "@carloscortezcloud/sayay-guard": ">=0.1.0",
    "@carloscortezcloud/styrr-llm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@carloscortezcloud/styrr-llm": {
      "optional": true
    },
    "@carloscortezcloud/sayay-guard": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carloscortezcloud/sayay-guard": "^0.1.1",
    "@carloscortezcloud/styrr-llm": "^0.4.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "type": "module",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
